<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace></RootNamespace>
    <AssemblyName>SetColorFromMaterial</AssemblyName>
    <TargetFramework>net481</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <Version>1.0.0</Version>
    <Product>Set Color from Material Add-On</Product>
    <AssemblyTitle>Set Color from Material Add-On</AssemblyTitle>
    <Authors>Cator and the Alibre Design forum community</Authors>
    <Company>Alibre Design forum community</Company>
    <Copyright>Script (c) Cator and the Alibre Design forum community. Add-on host (c) 2026 Stephen S. Mitchell.</Copyright>
    <PackageProjectUrl>https://www.alibre.com/forum/index.php?resources/set-color-from-material.150/</PackageProjectUrl>
    <Description>Host for the Set Color from Material Alibre Script program. This is a script that Cator wrote and others helped finalize - thanks for everyone's help - that will add a color when assigning material to your model. It has colors listed (RGB) for all the standard Alibre materials as well as colors that follow the KeyShot scheme. You may need to edit for your particular usage. Source: https://www.alibre.com/forum/index.php?resources/set-color-from-material.150/</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AlibreInstallRoot)' == ''">
    <AlibreInstallRoot Condition="'$(ProgramW6432)' != ''">$(ProgramW6432)</AlibreInstallRoot>
    <AlibreInstallRoot Condition="'$(ProgramW6432)' == ''">C:\Program Files</AlibreInstallRoot>
  </PropertyGroup>

  <Target Name="LocateAlibre" BeforeTargets="BeforeResolveReferences">
    <ItemGroup Condition="'$(AlibreProgramPath)' == ''">
      <_AlibreXCandidate Include="$(AlibreInstallRoot)\Alibre Design*\Program\AlibreX.dll" />
    </ItemGroup>
    <PropertyGroup Condition="'$(AlibreProgramPath)' == ''">
      <_AlibreDetected>%(_AlibreXCandidate.RootDir)%(_AlibreXCandidate.Directory)</_AlibreDetected>
    </PropertyGroup>
    <PropertyGroup Condition="'$(AlibreProgramPath)' == ''">
      <AlibreProgramPath>$(_AlibreDetected)</AlibreProgramPath>
    </PropertyGroup>

    <Error Condition="'$(AlibreProgramPath)' == ''"
           Text="No Alibre Design installation was found under $(AlibreInstallRoot). Pass -p:AlibreProgramPath=&quot;&lt;install&gt;\Program\&quot; (trailing backslash required)." />
    <Error Condition="!Exists('$(AlibreProgramPath)AlibreAddOn.dll')"
           Text="AlibreAddOn.dll was not found in $(AlibreProgramPath)." />
    <Error Condition="!Exists('$(AlibreProgramPath)Addons\AlibreScript\AlibreScriptAddOn.dll')"
           Text="The Alibre Script add-on was not found under $(AlibreProgramPath)Addons\AlibreScript. Install Alibre Script, or point AlibreProgramPath at an installation that has it." />
    <Message Importance="high" Text="Building against $(AlibreProgramPath)" />

    <ItemGroup>
      <Reference Include="AlibreAddOn">
        <HintPath>$(AlibreProgramPath)AlibreAddOn.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="AlibreX">
        <HintPath>$(AlibreProgramPath)AlibreX.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="AlibreScriptAddOn">
        <HintPath>$(AlibreProgramPath)Addons\AlibreScript\AlibreScriptAddOn.dll</HintPath>
        <Private>False</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="IronPython" Version="2.7.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="SetColorFromMaterial.ico" />
    <None Remove="SetColorFromMaterial.adc" />
    <None Remove="scripts\**\*.py" />
    <Content Include="SetColorFromMaterial.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SetColorFromMaterial.adc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="scripts\**\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
